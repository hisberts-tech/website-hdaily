# PostgreSQL connection string.
# For Neon (production): use the pooler URL shown in your Neon dashboard.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (non-pooler) URL — used by Prisma Migrate / db push.
# Same as DATABASE_URL but without "-pooler" in the hostname, or use the pooler URL for both.
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# For local Docker development:
# DATABASE_URL="postgresql://hdaily:hdaily@localhost:5432/hdaily?schema=public"
# DIRECT_URL="postgresql://hdaily:hdaily@localhost:5432/hdaily?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (Vite dev server + preview)
CORS_ORIGIN="http://localhost:3000,http://localhost:4173"

# Auth — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Manual MonCash: the merchant number customers send payments to
MONCASH_NUMBER="+509 3913 4651"

# Twilio SMS notifications (optional — leave blank to disable)
# Fill in your credentials from console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Admin phone number that receives new-order SMS alerts
ADMIN_PHONE="+509 3913 4651"
